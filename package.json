{
  "name": "amma-labs",
  "version": "0.1.0",
  "private": true,
  "description": "Amma Labs — book blood tests, get a home sample collection, read your reports online.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "staff:add": "node --env-file-if-exists=.env --import tsx --conditions=react-server scripts/add-staff.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "pdfkit": "^0.20.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/pg": "^8",
    "@types/pdfkit": "^0.17.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "vitest": "^3.2.7",
    "@playwright/test": "^1.63.0",
    "tsx": "^4"
  }
}
