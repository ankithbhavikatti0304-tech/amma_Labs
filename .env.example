# Copy to .env for local development. In production set these in your host's environment
# (Vercel → Project → Settings → Environment Variables). Never commit real values.
# `npm run dev` / `npm run build` read .env; the app refuses to start in production if
# anything here is unsafe or missing (see src/server/env.ts).

# ── Core ────────────────────────────────────────────────────────────────────
# Postgres. Use the pooled connection string (e.g. Neon's -pooler host) at runtime.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/amma_dev"
# Direct (non-pooled) connection, used only by `prisma migrate`. Optional; falls back to DATABASE_URL.
# DIRECT_URL=""
# Connections per server instance. Keep small on serverless.
# DATABASE_POOL_MAX=5

# The public address of the site. Must be https in production.
APP_URL="http://localhost:3000"
# 32+ random characters (openssl rand -base64 48). Keys the hash of one-time codes.
APP_SECRET="change-me-to-a-long-random-string-0123456789"
# true behind Vercel or a load balancer you control (then X-Forwarded-For is trusted for rate limits); false otherwise.
# REQUIRED in production so it is a deliberate choice.
# TRUST_PROXY=true

# ── SMS login codes ─────────────────────────────────────────────────────────
# dev: the code is shown on screen (never allowed in production). msg91: real SMS.
SMS_PROVIDER="dev"
# MSG91_AUTH_KEY=""
# MSG91_OTP_TEMPLATE_ID=""            # DLT-registered template with one variable for the code
# MSG91_TEMPLATE_BOOKING_CONFIRMED=""  # optional DLT templates for booking messages
# MSG91_TEMPLATE_SAMPLE_COLLECTED=""
# MSG91_TEMPLATE_REPORT_READY=""

# ── Payments ────────────────────────────────────────────────────────────────
# none: no online payment, patients pay at collection (fine for production). mock: a test "Pay" button, no money
# moves (never allowed in production). razorpay: real.
PAYMENT_PROVIDER="mock"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""   # webhook URL: https://YOUR-SITE/api/webhooks/razorpay  (events: payment.captured, order.paid, payment.failed)

# ── File storage (prescriptions, report PDFs) ───────────────────────────────
# local: a folder on disk (development only). s3: any S3-compatible bucket, with public access blocked.
STORAGE_DRIVER="local"
# LOCAL_STORAGE_DIR=".storage"
# S3_BUCKET=""
# S3_REGION="ap-south-1"
# S3_ENDPOINT=""               # for Cloudflare R2, Backblaze, MinIO etc. Leave out for AWS S3.
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=false

# ── WhatsApp (optional) ─────────────────────────────────────────────────────
# WHATSAPP_PROVIDER="cloud"     # Meta WhatsApp Cloud API; templates al_booking_confirmed, al_sample_collected, al_report_ready
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TOKEN=""

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/maintenance (24+ chars). Required in production. Vercel Cron sends it automatically when
# the variable is named CRON_SECRET.
# CRON_SECRET=""

# ── Tests only ──────────────────────────────────────────────────────────────
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/amma_test"
# E2E_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/amma_e2e"
